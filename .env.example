# GitHub Personal Access Token
# Create one at https://github.com/settings/tokens
# Required scopes: public_repo (read-only is sufficient for Stage 1)
GITHUB_TOKEN=your_github_token_here

# GitHub API base URL (optional, defaults to https://api.github.com)
# GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# LLM Configuration (required for goblin explain)
# ---------------------------------------------------------------------------

# API key for your LLM provider (OpenAI, or any OpenAI-compatible service)
LLM_API_KEY=your_llm_api_key_here

# LLM base URL (optional, defaults to OpenAI; point to Ollama or another proxy)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1  # local Ollama

# Model name (optional, defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=gpt-4o
# LLM_MODEL=llama3
